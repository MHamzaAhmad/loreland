/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	/**
	 * D1 Database - Central database for users, games, etc.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "loreland",
			"database_id": "TODO_CREATE_WITH_WRANGLER_D1_CREATE",
			"migrations_dir": "../../packages/db/migrations/d1"
		}
	],
	/**
	 * R2 Bucket - Object storage for generated images
	 */
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "loreland-images"
		}
	]
}