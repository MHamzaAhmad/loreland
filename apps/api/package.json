{
	"name": "api",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"db:generate": "bunx @better-auth/cli generate --config ./src/auth.static.ts --output ../../packages/db/src/schema/d1/auth.ts",
		"db:migrate": "wrangler d1 migrations apply loreland --local",
		"db:migrate:remote": "wrangler d1 migrations apply loreland --remote"
	},
	"dependencies": {
		"@ai-sdk/vercel": "^2.0.1",
		"@hono/zod-validator": "^0.4.3",
		"@packages/db": "workspace:*",
		"agents": "^0.3.1",
		"ai": "^6.0.3",
		"better-auth": "catalog:auth",
		"drizzle-orm": "catalog:database",
		"hono": "^4.11.3",
		"zod": "catalog:validation"
	},
	"devDependencies": {
		"@types/node": "^25.0.3",
		"wrangler": "^4.54.0"
	}
}