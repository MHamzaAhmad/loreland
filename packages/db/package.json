{
    "name": "@packages/db",
    "version": "0.0.1",
    "type": "module",
    "exports": {
        "./auth": "./src/auth/index.ts",
        "./schema/d1": "./src/schema/d1/index.ts",
        "./schema/agent": "./src/schema/agent/index.ts",
        "./migrations/agent": "./migrations/agent/migrations.js",
        "./types": "./src/types/index.ts"
    },
    "scripts": {
        "db:generate:d1": "drizzle-kit generate --config=drizzle.d1.config.ts",
        "db:generate:agent": "drizzle-kit generate --config=drizzle.agent.config.ts",
        "db:generate": "bun run db:generate:d1 && bun run db:generate:agent",
        "db:migrate:local": "wrangler d1 migrations apply loreland --local --config=../../apps/api/wrangler.jsonc",
        "db:migrate:remote": "wrangler d1 migrations apply loreland --remote --config=../../apps/api/wrangler.jsonc",
        "db:studio": "drizzle-kit studio --config=drizzle.d1.config.ts"
    },
    "dependencies": {
        "better-auth": "catalog:auth",
        "drizzle-orm": "catalog:database"
    },
    "devDependencies": {
        "drizzle-kit": "catalog:database",
        "wrangler": "catalog:core",
        "typescript": "catalog:core"
    }
}